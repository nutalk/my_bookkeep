# MySQL 连接 (必填)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bookkeep
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=bookkeep

# MySQL TLS。本地无 TLS 的 MySQL 可设 false；云数据库（TiDB Cloud / AWS RDS 等）
# 必须启用 TLS，保持未设置或设为 true（不校验证书）
MYSQL_SSL=false

# 微信登录 (选填)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
NEXT_PUBLIC_WECHAT_APP_ID=
